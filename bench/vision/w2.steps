# Images window 2: phase (a) decided (the FP32 truth redone without TF32, SGLang's own tower if it builds outside a
# server, the engine's embeddings dumped beside them), then the end-to-end agreement's engine side.
SRC=~/ling-engine-vision; B=$SRC/build; R=$V/../ref; P=$V/../prompts.jsonl
HUB=$HOME/.cache/huggingface
CK=$(ls -d $HUB/hub/models--RadixArk--Qwen3.8-27B-NVFP4/snapshots/*)
IMG=lmsysorg/sglang@sha256:b1259f3ea3275f66237c498ea388919729018bc9f01c3d638391e06e2cf3f469
ref_pass() {  # ref_pass ENV=1: one pass of reference.py in production's image
  docker run --rm --gpus all --network none --name vision-refs -v $HUB:$HUB:ro -v $V/..:$V/.. -v $SRC:$SRC:ro \
    -e HF_HUB_OFFLINE=1 -e $1 --entrypoint python3 $IMG $SRC/bench/vision/reference.py $CK $R
}
step vision-tests $B/ling-vision-tests
step ref-fp32 ref_pass ONLY_FP32=1
step ref-sgl ref_pass ONLY_SGL=1
step vision-check $B/ling-run --model $CK --vision-check $R --vision-bench --vision-dump
step greedy $B/ling-run --model $CK --vision-prompts $P --greedy-out $V/../engine-greedy.jsonl --max-tokens 48
step cases python3 $SRC/bench/vision/agree.py cases $V/..
step force bash -c "$B/ling-run --model $CK --vision-prompts $P --force-file $V/../cases.jsonl > $V/../engine-force.jsonl"
step agree python3 $SRC/bench/vision/agree.py $V/..
